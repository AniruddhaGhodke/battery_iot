{
  "name": "battery-iot",
  "version": "0.1.0",
  "private": true,
  "description": "Exergi Murphy battery pack monitoring - live dashboard",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "tsc --noEmit",
    "ingest:dev": "node --env-file-if-exists=.env.local --watch ingest/main.ts",
    "ingest": "node --env-file-if-exists=.env.local ingest/main.ts",
    "migrate": "node --env-file-if-exists=.env.local db/migrate-cli.ts",
    "build:ingest": "esbuild ingest/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/ingest.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "mqtt": "^5.16.0",
    "next": "^16.3.6",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  },
  "type": "module"
}
