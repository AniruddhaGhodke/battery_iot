# Production settings: copy to /opt/battery-iot/.env on the droplet.
# Same variables as the root .env.example, plus the ones below.

# ---- Server ---------------------------------------------------------------------

# Hostname for HTTPS. Without a domain, <ip-with-dashes>.sslip.io works.
SITE_ADDRESS=159-89-160-225.sslip.io

# Dashboard login. Single quotes keep Compose from expanding the $ in the hash.
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH='$2a$14$...'

# Database password; long and random (openssl rand -hex 24).
POSTGRES_PASSWORD=

# ---- MQTT -----------------------------------------------------------------------

# Our own broker, the mosquitto service in the same Compose project.
MQTT_URL=mqtt://mosquitto:1883
# Ingest's broker login (read-only in mosquitto/acl). The same password must
# be in mosquitto/auth/passwd; see README, "Broker accounts".
MQTT_USERNAME=bms-ingest
MQTT_PASSWORD=
MQTT_TOPIC=emspl/a7f3c2/+/data
# The only ingest using this id. Local ingest stays off (it is opt-in there).
MQTT_CLIENT_ID=emspl-a7f3c2-ingest

# ---- Packs + dashboard ------------------------------------------------------------

ALLOWED_DEVICES=EM_PACK_16S_03,EM_PACK_57S_01
# Any pack that publishes a valid reading with the device login is stored,
# with no allowlist step. To block one: update packs set enabled = false.
AUTO_REGISTER_DEVICES=true
STALE_AFTER_S=60

# ---- WhatsApp alerts (README, "WhatsApp alerts") -------------------------------

ALERTS_ENABLED=true
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=battery_alert
WHATSAPP_TEMPLATE_LANG=en
# Numbers with country code, comma separated: 919876543210,919812345678
ALERT_RECIPIENTS=
# ALERT_MUTE_PACKS=EM_PACK_16S_03
# Defaults, change only if needed:
# ALERT_OFFLINE_MIN=10
# ALERT_SPREAD_MV=100
# ALERT_ANALYSIS_TIMEOUT_S=8

# ---- Remote configuration (README, "Remote configuration") ----------------------

# Defaults are fine; the ACL in deploy/mosquitto/acl is what matters.
# CONFIG_ACK_TIMEOUT_S=20
# CONFIG_RESTART_GRACE_S=120

# ---- Firmware updates (README, "Firmware updates (OTA)") -------------------------

# SITE_ADDRESS above is reused: it is the URL packs download firmware from, so
# it must be the public HTTPS name. Images are served from the `firmware`
# volume by Caddy, outside basic auth.
# OTA_DOWNLOAD_TIMEOUT_MIN=15
# OTA_RESTART_GRACE_MIN=5
