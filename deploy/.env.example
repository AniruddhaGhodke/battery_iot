# Production settings: copy to /opt/battery-iot/.env on the droplet.
# Same variables as the root .env.example, plus the ones below.

# ---- Server ---------------------------------------------------------------------

# Hostname for HTTPS. Without a domain, <ip-with-dashes>.sslip.io works.
SITE_ADDRESS=159-89-160-225.sslip.io

# Dashboard login. Single quotes keep Compose from expanding the $ in the hash.
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH='$2a$14$...'

# Database password; long and random (openssl rand -hex 24).
POSTGRES_PASSWORD=

# ---- MQTT -----------------------------------------------------------------------

MQTT_URL=mqtt://broker.emqx.io:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=emspl/a7f3c2/+/data
# The only ingest using this id. Local ingest stays off (it is opt-in there).
MQTT_CLIENT_ID=emspl-a7f3c2-ingest

# ---- Packs + dashboard ------------------------------------------------------------

ALLOWED_DEVICES=EM_PACK_16S_03
AUTO_REGISTER_DEVICES=false
STALE_AFTER_S=60
