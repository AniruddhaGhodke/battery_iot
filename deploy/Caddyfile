# HTTPS for the dashboard. SITE_ADDRESS is a hostname pointing at the droplet;
# Caddy gets its Let's Encrypt certificate on first start.
#
# Basic auth until the app has its own logins (TODO 3). New password hash:
#   docker compose exec caddy caddy hash-password --plaintext '<password>'

{$SITE_ADDRESS} {
	encode zstd gzip

	# Firmware images, served straight from the shared volume with no basic
	# auth: the ESP32 downloads these itself and cannot send credentials.
	# Only "<64 hex>.bin" is ever written there by the dashboard, so a name
	# has to be an image's own SHA-256 to exist at all — the URL is the
	# capability. No directory listing, nothing else under this path.
	handle /firmware/*.bin {
		root * /srv
		file_server
	}

	handle {
		basic_auth {
			{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
		}
		reverse_proxy web:3100
	}
}
