# Who may do what. Usernames match the accounts in passwd (droplet only).
# One shared account for all packs for now; per-pack accounts can replace it
# later (TODO 7), e.g. "pattern write emspl/a7f3c2/%u/data".

# The packs: publish telemetry and configuration acknowledgements, and read
# the configuration sent to them. Nothing else.
user emspl-device
topic write emspl/a7f3c2/+/data
topic write emspl/a7f3c2/+/config/ack
topic read emspl/a7f3c2/+/config/set
topic write emspl/a7f3c2/+/control/ack
topic read emspl/a7f3c2/+/control/set
topic write emspl/a7f3c2/+/ota/status
topic read emspl/a7f3c2/+/ota/command

# The ingest worker: read telemetry and acknowledgements, and publish
# configuration. It is the only client allowed to write config/set, which is
# what stops anything else reconfiguring a pack. The dashboard has no broker
# credentials at all and goes through ingest over HTTP (README, "Remote
# configuration").
user bms-ingest
topic read emspl/a7f3c2/+/data
topic read emspl/a7f3c2/+/config/ack
topic write emspl/a7f3c2/+/config/set
# Switching the channel is kept on its own topic so that permission to
# configure a pack and permission to open its contactor can be separated —
# drop the next two lines to leave ingest able to configure but not switch.
topic read emspl/a7f3c2/+/control/ack
topic write emspl/a7f3c2/+/control/set
# Firmware updates, again on their own topic: ota/command carries only a URL
# and a hash, so the ability to start a rollout can be separated from the
# ability to change settings (README, "Firmware updates").
topic read emspl/a7f3c2/+/ota/status
topic write emspl/a7f3c2/+/ota/command
