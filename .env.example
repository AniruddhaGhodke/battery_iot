# Copy to .env.local and adjust. .env.local is gitignored.
# Used by `npm run dev`, `npm run ingest:dev` and `docker compose` alike.

# ---- MQTT (read by ingest only) ---------------------------------------------

# Broker the ESP32 publishes to: our own Mosquitto on the droplet. Same
# settings as MQTTX. Login: the bms-ingest account (password from the
# droplet's .env; never commit it).
MQTT_URL=mqtt://159-89-160-225.sslip.io:1883
MQTT_USERNAME=bms-ingest
MQTT_PASSWORD=

# Topic the device publishes on. `+` matches one level.
MQTT_TOPIC=emspl/a7f3c2/+/data

# Must be unique on the broker, or two clients keep kicking each other off.
# The droplet's ingest already uses this id, so a local ingest needs its own
# (or the droplet's stopped). Also do not run `npm run ingest:dev` and the
# Docker ingest at the same time: they share this id.
MQTT_CLIENT_ID=emspl-a7f3c2-ingest

# ---- Packs --------------------------------------------------------------------

# Added to the packs table at ingest startup, comma separated. Only enabled
# packs in that table are stored.
ALLOWED_DEVICES=EM_PACK_16S_03,EM_PACK_57S_01

# Accept and register any new device_id automatically. Only on a private broker.
AUTO_REGISTER_DEVICES=false

# ---- Dashboard -----------------------------------------------------------------

# A pack with no message for this long is shown as offline.
STALE_AFTER_S=60

# ---- WhatsApp alerts (ingest; README, "WhatsApp alerts") -------------------------

# Off by default so a local ingest never messages anyone. Alerts are still
# worked out and printed in the ingest log when off.
ALERTS_ENABLED=false
# Meta WhatsApp Cloud API: permanent System User token and the sender's
# phone number id (WhatsApp Manager > API setup). Never commit the token.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved Utility template with 4 body variables (README has the text).
WHATSAPP_TEMPLATE=battery_alert
WHATSAPP_TEMPLATE_LANG=en
# Who gets every alert: numbers with country code, comma separated.
ALERT_RECIPIENTS=
# Packs that never alert, e.g. a bench pack that is often switched off.
ALERT_MUTE_PACKS=

# ---- Database --------------------------------------------------------------------

# Defaults match docker-compose.yml; only set these to use another database.
# Inside Docker, compose sets DATABASE_URL itself.
# DATABASE_URL=postgres://bms:bms_local@localhost:5433/bms
# POSTGRES_PASSWORD=bms_local

# ---- Remote configuration (README, "Remote configuration") ----------------------

# {slug} is the pack's own topic segment, learned from its telemetry topic.
# CONFIG_SET_TOPIC=emspl/a7f3c2/{slug}/config/set
# CONFIG_ACK_TOPIC=emspl/a7f3c2/{slug}/config/ack
# CONFIG_ACK_TIMEOUT_S=20
# CONFIG_RESTART_GRACE_S=120
