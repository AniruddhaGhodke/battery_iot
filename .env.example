# Copy to .env.local and adjust. .env.local is gitignored.
# Used by `npm run dev`, `npm run ingest:dev` and `docker compose` alike.

# ---- MQTT (read by ingest only) ---------------------------------------------

# Broker the ESP32 publishes to. Same settings as MQTTX.
MQTT_URL=mqtt://broker.emqx.io:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Topic the device publishes on. `+` matches one level.
MQTT_TOPIC=emspl/a7f3c2/+/data

# Must be unique on a public broker, or two clients keep kicking each other
# off. Also do not run `npm run ingest:dev` and the Docker ingest at the same
# time: they share this id.
MQTT_CLIENT_ID=emspl-a7f3c2-ingest

# ---- Packs --------------------------------------------------------------------

# Added to the packs table at ingest startup, comma separated. Only enabled
# packs in that table are stored. On a public broker anyone can publish to
# your topic, so list your devices here.
ALLOWED_DEVICES=EM_PACK_16S_03

# Accept and register any new device_id automatically. Only on a private broker.
AUTO_REGISTER_DEVICES=false

# ---- Dashboard -----------------------------------------------------------------

# A pack with no message for this long is shown as offline.
STALE_AFTER_S=60

# ---- Database --------------------------------------------------------------------

# Defaults match docker-compose.yml; only set these to use another database.
# Inside Docker, compose sets DATABASE_URL itself.
# DATABASE_URL=postgres://bms:bms_local@localhost:5433/bms
# POSTGRES_PASSWORD=bms_local
