# Copy to .env.local and adjust. .env.local is gitignored.

# Broker the ESP32 publishes to. Same settings as MQTTX.
# The server connects over plain TCP; browsers never talk to the broker.
MQTT_URL=mqtt://broker.emqx.io:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Topic the device publishes on. `+` matches one level.
MQTT_TOPIC=emspl/a7f3c2/+/data

# Must be unique on a public broker, or two clients keep kicking each other off.
MQTT_CLIENT_ID=emspl-a7f3c2-nextjs

# Only these device_ids are accepted, comma separated. Empty = accept any.
# On a public broker anyone can publish to your topic, so set this.
ALLOWED_DEVICES=EM_PACK_16S_03

# Readings kept in memory per pack for the trend charts. ~5 s interval x 720 = 1 h.
HISTORY_SIZE=720

# A pack with no message for this long is shown as offline.
STALE_AFTER_S=60
